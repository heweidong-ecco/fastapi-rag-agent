# ==================== 敏感配置（必填） ====================
# ==================== 阿里百炼 AI 服务 ====================
DASHSCOPE_API_KEY=sk-your-api-key-here
# ==================== 生成/对话 LLM 可切换(可选;不填 = 走上面 DashScope 百炼) ====================
# 切 DeepSeek 官方等 OpenAI 兼容端点,填下面三组键(embedding 仍走 DASHSCOPE,不受影响):
# LLM_BASE_URL=https://api.deepseek.com
# LLM_API_KEY=sk-your-deepseek-or-provider-key
# LLM_MODEL_FAST=deepseek-chat   # 轻量角色:查询改写/基础 Agent/RAG 答案(原 qwen-turbo 位)
# LLM_MODEL_CHAT=deepseek-chat   # 重量角色:规划/质检/高级 Agent/流式(原 qwen-plus 位)
# ==================== JWT 认证 ====================
JWT_SECRET_KEY=your-jwt-secret-key-here
# ==================== 登录口令（必填） ====================
# ⚠️ 缺失则应用**拒绝启动**（config.validate_config）。
# 2026-09-15 从 api/auth.py 的硬编码字面量迁出 —— 那曾是公开仓库上的活凭据（见 docs/decisions/DEC-001）。
# 生成随机口令：python3 -c "import secrets; print(secrets.token_urlsafe(24))"
LOGIN_PASSWORD=your-login-password-here
# ==================== 数据库（Docker 内部使用，一般不改） ====================
POSTGRES_PASSWORD=mysecretpassword
# ==================== 连接池大小设置 ====================
DB_MIN_CONN=2
DB_MAX_CONN=20
# ==================== 非敏感配置（可选，有默认值） ====================
# ==================== 登录用户名 ====================
LOGIN_USER_NAME=admin
# 可选：**设了才存在** test_user 账号（PREMIUM 角色）—— 用于验证非 admin 的配额/预算路径。
# 不设 = 该账号不存在（fail-closed，不留任何默认口令）。
# TEST_USER_PASSWORD=
# 注：原 API_KEY 配置项已删除 —— 全仓 0 个调用方（认证走 auth.verify_api_key + api_keys 表）。
# ==================== JWT 认证 ====================
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
# ==================== 数据库（Docker 内部使用，一般不改） ====================
# 注：此处填 Docker 服务名；本地开发时 config.py 会自动覆盖为 localhost
POSTGRES_DB=rag_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# ==================== Redis（Docker 内部使用，一般不改） ====================
# 注：此处填 Docker 服务名；本地开发时 config.py 会自动覆盖为 localhost
REDIS_HOST=redis
REDIS_PORT=6379
# ==================== 重排序模型配置 ====================
RERANKER_MODEL_NAME=bge-reranker-v2-m3

