
# ==================== 敏感配置（必填） ====================
# ==================== 阿里百炼 AI 服务 ====================
# 阿里百炼 API Key（必填，用于 LLM + Embedding + 搜索）
DASHSCOPE_API_KEY=sk-your-api-key-here
# ==================== JWT 认证 ====================
# JWT 签名密钥（必填，请使用随机字符串）
JWT_SECRET_KEY=your-jwt-secret-key-here
# ==================== 数据库（Docker 内部使用，一般不改） ====================
# 数据库密码（必填，请修改为强密码）
POSTGRES_PASSWORD=mysecretpassword
# Mem0 配置（可选，用于长期记忆功能）
MEM0_API_KEY=your-mem0-api-key
# ==================== 连接池大小设置 ====================
DB_MIN_CONN=2
DB_MAX_CONN=20
# ==================== 非敏感配置（可选，有默认值） ====================
# ==================== API 基础配置 ====================
API_KEY=your-api-secret-key-here
# ==================== JWT 认证 ====================
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
# ==================== 数据库（Docker 内部使用，一般不改） ====================
# 注：此处填 Docker 服务名；本地开发时 config.py 会自动覆盖为 localhost
POSTGRES_DB=rag_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# ==================== Redis（Docker 内部使用，一般不改） ====================
# 注：此处填 Docker 服务名；本地开发时 config.py 会自动覆盖为 localhost
REDIS_HOST=redis
REDIS_PORT=6379
# ==================== 重排序模型配置 ====================
RERANKER_MODEL_NAME=bge-reranker-v2-m3
# ==================== 默认每日 Token 预算 配置 ====================
DEFAULT_DAILY_TOKEN_BUDGET=100000
